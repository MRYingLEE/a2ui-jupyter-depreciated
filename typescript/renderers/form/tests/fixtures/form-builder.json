                },
                "enableDate": true,
                "enableTime": false
              },
              {
                "id": "field_at",
                "component": "DateTimeInput",
                "label": "at",
                "value": {
                  "@path": "/at"
                },
                "enableDate": false,
                "enableTime": true
              },
              {
                "id": "field_when",
