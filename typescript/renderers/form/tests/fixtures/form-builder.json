                "label": "when",
                "value": {
                  "@path": "/when"
                },
                "enableDate": true,
                "enableTime": true
              },
              {
                "id": "form_actions",
                "component": "Row",
                "justify": "end",
                "children": ["form_cancel", "form_submit"]
              },
              {
                "id": "form_cancel",
                "component": "Button",
                "child": "form_cancel_label",
                "action": {
                  "event": {
                    "name": "discard"
                  }
                }
              },
              {
                "id": "form_cancel_label",
                "component": "Text",
                "text": "Discard"
              },
              {
                "id": "form_submit",
                "component": "Button",
                "child": "form_submit_label",
                "variant": "primary",
                "action": {
                  "event": {
                    "name": "save"
                  }
                },
                "@checks": [
                  {
                    "condition": {
                      "@call": "and",
                      "args": {
                        "values": [
                          {
                            "@call": "required",
                            "args": {
                              "value": {
                                "@path": "/name"
                              }
                            }
                          },
                          {
                            "@call": "required",
                            "args": {
                              "value": {
                                "@path": "/color"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "message": "Complete the required fields"
                  }
                ]
              },
              {
                "id": "form_submit_label",
                "component": "Text",
                "text": "Save"
              }
            ],
            "dataModel": {
              "name": "",
              "notes": "",
              "secret": "",
              "age": "42",
              "agree": true,
              "color": ["red"],
              "tags": [],
              "level": 1,
