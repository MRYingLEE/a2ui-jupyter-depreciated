                "label": "tags",
                "variant": "multipleSelection",
                "options": [
                  {
                    "label": "a",
                    "value": "a"
                  },
                  {
                    "label": "b",
                    "value": "b"
                  }
                ],
                "value": {
                  "@path": "/tags"
                }
              },
              {
